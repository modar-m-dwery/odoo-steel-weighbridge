<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_weighbridge" model="res.groups.privilege">
        <field name="name">Weighbridge</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_weighbridge_sales" model="res.groups">
        <field name="name">Sales Clerk</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_weighbridge"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_weighbridge_purchase" model="res.groups">
        <field name="name">Purchase Clerk</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_weighbridge"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_weighbridge_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_weighbridge"/>
        <field name="implied_ids" eval="[(4, ref('group_weighbridge_sales')), (4, ref('group_weighbridge_purchase'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <!-- Group rules are OR-ed: a manager inherits both clerk groups and sees both types. -->
        <record id="rule_ticket_sales" model="ir.rule">
            <field name="name">Weigh tickets: sales clerks see sales</field>
            <field name="model_id" ref="model_steel_weigh_ticket"/>
            <field name="groups" eval="[(4, ref('group_weighbridge_sales'))]"/>
            <field name="domain_force">[('ticket_type', '=', 'sale')]</field>
        </record>
        <record id="rule_ticket_purchase" model="ir.rule">
            <field name="name">Weigh tickets: purchase clerks see purchases</field>
            <field name="model_id" ref="model_steel_weigh_ticket"/>
            <field name="groups" eval="[(4, ref('group_weighbridge_purchase'))]"/>
            <field name="domain_force">[('ticket_type', '=', 'purchase')]</field>
        </record>

        <!-- Global rules are AND-ed with everything else. -->
        <record id="rule_ticket_company" model="ir.rule">
            <field name="name">Weigh tickets: multi-company</field>
            <field name="model_id" ref="model_steel_weigh_ticket"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_summary_company" model="ir.rule">
            <field name="name">Daily summaries: multi-company</field>
            <field name="model_id" ref="model_steel_daily_summary"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
