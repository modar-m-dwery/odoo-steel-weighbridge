<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="steel_daily_summary_view_list" model="ir.ui.view">
        <field name="name">steel.daily.summary.list</field>
        <field name="model">steel.daily.summary</field>
        <field name="arch" type="xml">
            <list string="Daily Summaries" create="0" edit="0">
                <field name="date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="ticket_count" sum="Total tickets"/>
                <field name="net_ton" sum="Total tonnes"/>
            </list>
        </field>
    </record>

    <record id="action_steel_daily_summary" model="ir.actions.act_window">
        <field name="name">Daily Summaries</field>
        <field name="res_model">steel.daily.summary</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No summary yet</p>
            <p>The "Weighbridge: Daily Summary" scheduled action fills this list once a day.</p>
        </field>
    </record>
</odoo>
